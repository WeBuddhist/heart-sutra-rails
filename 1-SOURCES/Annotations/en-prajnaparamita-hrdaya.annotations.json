   "alignment": {
    "pair_row": 8,
    "target_side_text": "​དེ་ནས་སངས་རྒྱས་ཀྱི་མཐུས། ​ཚེ་དང་ལྡན་པ་ཤཱ་རིའི་བུས་བྱང་ཆུབ་སེམས་དཔའ་ཆེན་པོ་འཕགས་པ་སྤྱན་རས་གཟིགས་དབང་ཕྱུག་ལ་འདི་སྐད་ཅེས་སྨྲས་སོ། །​",
    "target_side_openpecha": [
     {
      "text_id": "BdfDD44nDSOqa13HgTvd7",
      "instance_id": "FsrpfLxgRL9UniIrc7c5o",
