    "raw": "\\[विस्तरमातृका\\]  "
   },
   "text": "[विस्तरमातृका]"
  },
  "1-1": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 2
   },
   "text": "॥नमः सर्वज्ञाय॥"
  },
  "1-2": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 6
   },
   "text": "एवं मया श्रुतम्।"
  },
  "1-3": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 7
   },
   "text": "एकस्मिन् समये भगवान् राजगृहे विहरति स्म गृध्रकूटे पर्वते महता भिक्षुसंघेन सार्धं महता च बोधिसत्त्वसंघेन।"
  },
  "1-4": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 8
   },
   "text": "तेन खलु समयेन भगवान् गम्भीरावसंबोधं नाम समाधिं समापन्नः।"
  },
  "1-5": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 9
   },
   "text": "तेन च समयेन आर्यावलोकितेश्वरो बोधिसत्त्वो महासत्त्वो गम्भीरायां प्रज्ञापारमितायां चर्यां चरमाणः एवं व्यवलोकयति स्म।"
  },
  "1-6": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 10
   },
   "text": "पञ्च स्कन्धांस्तांश्च स्वभावशून्यं व्यवलोकयति॥"
  },
  "1-7": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 11,
    "raw": "अथायुष्मान् शारिपुत्रो बुद्धानुभावेन आर्यावलोकितेश्वरं बोधिसत्त्वमेतदवोचत्- यः कश्चित् कुलपुत्रो \\[वा कुलदुहिता वा अस्यां\\] गम्भीरायां प्रज्ञापारमितायां चर्यां चर्तुकामः, कथं शिक्षितव्यः ?   "
   },
   "text": "अथायुष्मान् शारिपुत्रो बुद्धानुभावेन आर्यावलोकितेश्वरं बोधिसत्त्वमेतदवोचत्- यः कश्चित् कुलपुत्रो [वा कुलदुहिता वा अस्यां] गम्भीरायां प्रज्ञापारमितायां चर्यां चर्तुकामः, कथं शिक्षितव्यः ?"
  },
  "1-8": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 12,
    "raw": "एवमुक्ते आर्यावलोकितेश्वरो बोधिसत्त्वो महासत्त्वः आयुष्मन्तं शारिपुत्रमेतदवोचत्- यः कश्चिच्छारिपुत्र कुलपुत्रो वा कुलदुहिता वा \\[अस्यां\\] गम्भीरायां प्रज्ञापारमितायां चर्यां चर्तुकामः, तेनैवं व्यवलोकितव्यम्-पञ्च स्कन्धांस्तांश्च स्वभावशून्यान् समनुपश्यति स्म।   "
   },
   "text": "एवमुक्ते आर्यावलोकितेश्वरो बोधिसत्त्वो महासत्त्वः आयुष्मन्तं शारिपुत्रमेतदवोचत्- यः कश्चिच्छारिपुत्र कुलपुत्रो वा कुलदुहिता वा [अस्यां] गम्भीरायां प्रज्ञापारमितायां चर्यां चर्तुकामः, तेनैवं व्यवलोकितव्यम्-पञ्च स्कन्धांस्तांश्च स्वभावशून्यान् समनुपश्यति स्म।"
  },
  "1-9": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 13
   },
   "text": "रूपं शून्यता, शून्यतैव रूपम्।"
  },
  "1-10": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 14
   },
   "text": "रूपान्न पृथक् शून्यता, शून्यताया न पृथग् रूपम्।"
  },
  "1-11": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 15
   },
   "text": "यद्रूपं सा शून्यता, या शून्यता तद्रूपम्।"
  },
  "1-12": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 16
   },
   "text": "एवं वेदनासंज्ञासंस्कारविज्ञानानि च शून्यता।"
  },
  "1-13": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 17
   },
   "text": "एवं शारिपुत्र सर्वधर्माः शून्यतालक्षणा अनुत्पन्ना अनिरुद्धा अमला विमला अनूना असंपूर्णाः।"
  },
  "1-14": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 18
   },
   "text": "तस्मात्तर्हि शारिपुत्र शून्यतायां न रूपम्, न वेदना, न संज्ञा, न संस्काराः, न विज्ञानम्, न चक्षुर्न श्रोत्रं न घ्राणं न जिह्वा न कायो न मनो न रूपं न शब्दो न गन्धो न रसो न स्प्रष्टव्यं न धर्मः।"
  },
  "1-15": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 19
   },
   "text": "न चक्षुर्धातुर्यावन्न मनोधातुर्न धर्मधातुर्न मनोविज्ञानधातुः।"
  },
  "1-16": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 20
   },
   "text": "न विद्या नाविद्या न क्षयो यावन्न जरामरणं न जरामरणक्षयः, न दुःखसमुदयनिरोधमार्गा न ज्ञानं न प्राप्तिर्नाप्राप्तिः।"
  },
  "1-17": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 21
   },
   "text": "तस्माच्छारिपुत्र अप्राप्तित्वेन बोधिसत्त्वानां प्रज्ञापारमितामाश्रित्य विहरति चित्तावरणः।"
  },
  "1-18": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 22
   },
   "text": "चित्तावरणनास्तित्वादत्रस्तो विपर्यासातिक्रान्तो निष्ठनिर्वाणः।"
  },
  "1-19": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 23
   },
   "text": "त्र्यध्वव्यवस्थिताः सर्वबुद्धाः प्रज्ञापारमितामाश्रित्य अनुत्तरां सम्यक्संबोधिमभिसंबुद्धाः।"
  },
  "1-20": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 24
   },
   "text": "तस्माद् ज्ञातव्यः प्रज्ञापारमितामहामन्त्रः अनुत्तरमन्त्रः असमसममन्त्रः सर्वदुःखप्रशमनमन्त्रः सत्यममिथ्यत्वात् प्रज्ञापारमितायामुक्तो मन्त्रः।"
  },
  "1-21": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 25
   },
   "text": "तद्यथा- गते गते पारगते पारसंगते बोधि स्वाहा।"
  },
  "1-22": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 26
   },
   "text": "एवं शारिपुत्र गम्भीरायां प्रज्ञापारमितायां चर्यायां शिक्षितव्यं बोधिसत्त्वेन॥"
  },
  "1-23": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 27
   },
   "text": "अथ खलु भगवान् तस्मात्समाधेर्व्युत्थाय आर्यावलोकितेश्वरस्य बोधिसत्त्वस्य साधुकारमदात्- साधु साधु कुलपुत्र।"
  },
  "1-24": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 28
   },
   "text": "एवमेतत् कुलपुत्र, एवमेतद् गम्भीरायां प्रज्ञापारमितायां चर्यं चर्तव्यं यथा त्वया निर्दिष्टम्।"
  },
  "1-25": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 29
   },
   "text": "अनुमोद्यते तथागतैरर्हद्भिः॥"
  },
  "1-26": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 30
   },
   "text": "इदमवोचद्भगवान्।"
  },
  "1-27": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 31
   },
   "text": "आनन्दमना आयुष्मान् शारिपुत्रः आर्यावलोकितेश्वरश्च बोधिसत्त्वः सा च सर्वावती परिषत् सदेवमानुषासुरगन्धर्वश्च लोको भगवतो भाषितमभ्यनन्दन्॥"
  },
  "1-28": {
   "source": {
    "file": "sherab-root-sa(bo-sa).md",
    "row": 32
   },
   "text": "इति प्रज्ञापारमिताहृदयसूत्रं समाप्तम्।"
  }
 },
