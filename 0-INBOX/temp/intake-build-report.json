  "alignment_review": [],
  "headings": 23,
  "toc_labels_moved_from_rows": [
   {
    "row": 14,
    "text": "༤༽ ཤེར་ཕྱིན་ལ་སྤྱོད་ཚུལ་མདོར་བསྟན་པ།"
   },
   {
    "row": 14,
    "text": "ལན་བསྟན་པ།"
   },
   {
    "row": 18,
    "text": "༦༽ རང་བཞིན་ཤེར་ཕྱིན་གཏན་ལ་དབབ་པ།"
   },
   {
    "row": 18,
    "text": "༥༽ ཤེར་ཕྱིན་གྱི་ངོ་བོ་རྒྱས་པར་བཤད་པ།"
   },
   {
    "row": 33,
    "text": "༨༽ ཕུང་པོ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 33,
    "text": "༧༽ ལམ་ཤེར་ཕྱིན་སྒོམ་ཚུལ།"
   },
   {
    "row": 39,
    "text": "༩༽སྐྱེ་མཆེད་ལ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 41,
    "text": "༡༠༽ཁམས་ལ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 43,
    "text": "༡༡༽ རྟེན་ན་འབྲེལ་ལ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 46,
    "text": "༡༢༽བདེན་པ་ལ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 48,
    "text": "༡༣༽གནས་དང་གནས་མིན་ལ་མཁས་པར་བྱ་བ།"
   },
   {
    "row": 52,
    "text": "༡༥༽ དེ་རྟོགས་པའི་ལམ་གྱི་ཕན་ཡོན།"
   },
   {
    "row": 57,
    "text": "༡༦༽ ལམ་དེས་རྟོགས་པའི་འབྲས་བུ་བཤད་པ།"
   },
   {
    "row": 60,
    "text": "༡༧༽ ཕན་ཡོན་དང་བཅས་པའི་གཟུངས་སྔགས་བསྟན་པ།"
   },
   {
    "row": 69,
    "text": "༡༨༽ དོན་བསྡུའི་ཚུལ་དུ་ཤེར་ཕྱིན་ལ་སློབ་པར་གདམས་པ།"
   },
   {
    "row": 71,
    "text": "༼༡༩༽ མཐུན་འགྱུར་གྱི་སྒོ་ནས་ཐེ་ཚོམ་བསལ་བ།"
   },
   {
    "row": 79,
    "text": "༢༠༽རྩ་བའི་གསུམ་པ། ​ཡི་རང་མངོན་པར་བསྟོད་པ།"
   },
   {
    "row": 85,
    "text": "༢༡༽ཐ་མར་དགེ་བ་མཇུག མཛད་བྱང་།"
   }
  ],
